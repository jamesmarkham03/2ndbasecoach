# Copy this file to .env.local and fill in the values.

# --- Used by the app (from Supabase dashboard -> Project Settings -> API Keys) ---
# Only the PUBLISHABLE key goes here. Never put the secret/service_role key anywhere in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Used only by scripts/backup.py (your app login) ---
# No VITE_ prefix on purpose: Vite only puts VITE_* values into the app, so these never reach the browser.
COACH_EMAIL=you@example.com
COACH_PASSWORD=your-app-password
